<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Orçamento explícito de foreground escalado pela área ativa da janela (WindowMetrics),
            adequado para UI adaptativa (celulares, dobráveis, tablets e janelas redimensionáveis).
            Ordem obrigatória: foreground -> background.
        -->
        <memory-budget
            android:state="foreground"
            android:maxMb="160"
            android:additionalBytesPerDisplayPixel="16" />

        <!-- Orçamento mais restritivo quando o processo está em background -->
        <memory-budget
            android:state="background"
            android:maxMb="48" />
    </application>

</manifest>
